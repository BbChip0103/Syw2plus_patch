# Copy to env.local.sh (gitignored) only when choosing to enable the loop.
# This example is not loaded automatically; never put credentials here.
LOOP_WORKER=codex
# Fixed role IDs (do not replace with CLI defaults or short aliases).
LOOP_ROLE=work
LOOP_CODEX_WORK_MODEL=gpt-5.6-luna
LOOP_CODEX_MIDDLE_MODEL=gpt-5.6-sol
LOOP_CODEX_ASTRA_MODEL=gpt-6-astra
LOOP_CLAUDE_WORK_MODEL=claude-sonnet-5
LOOP_CLAUDE_MIDDLE_MODEL=claude-opus-5
LOOP_CLAUDE_STRATEGY_MODEL=claude-fable-5
LOOP_STRATEGY_PROVIDER=codex  # codex=Astra, claude=Fable; no automatic fallback
LOOP_MIDDLE_PROVIDER=claude
# Legacy aliases (leave empty; conflicting values are rejected).
LOOP_CODEX_MODEL=""
LOOP_MODEL=""
LOOP_JUDGE=claude
LOOP_WORK_EFFORT=high
LOOP_MIDDLE_EFFORT=high
LOOP_ASTRA_EFFORT=medium       # 큰 분기·교착에서만 명시적으로 high
LOOP_ASTRA_REVIEW_INTERVAL=10  # cadence 힌트; 자동 호출하지 않음
LOOP_MAX_LAPS=1                 # explicit 0 means continuous execution
LOOP_ENABLE_AGENT=0             # 1 enables paid headless sessions
LOOP_ALLOW_COMMITS=0            # 1 only after explicit user authorization
LOOP_SKIP_PERMISSIONS=0
LOOP_EXTRA_DIRS=""              # --add-dir is NOT a read-only boundary
# LOOP_PATH="/absolute/path/to/cli/bin:/usr/bin:/bin"

# Commands: loopctl models | strategy | plan | review | run | dry [work|middle|astra]
